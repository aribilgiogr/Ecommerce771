@model IEnumerable<ModelDto>
@{
    ViewData["Title"] = "Kayıtlı Modeller";
}
<h2>@ViewData["Title"]</h2>
<a class="btn btn-primary mb-4" asp-action="create">Yeni Model Ekle</a>
<form method="post" onsubmit="return confirm('Emin misiniz?')">
    <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 row-cols-xl-6 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card border-1 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@item.Name</h5>
                        <div class="d-flex justify-content-between">
                            <a class="btn btn-sm btn-info" asp-action="edit" asp-route-id="@item.Id">Düzenle</a>
                            <button class="btn btn-sm btn-danger" type="submit" asp-action="delete" asp-route-id="@item.Id">Sil</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</form>