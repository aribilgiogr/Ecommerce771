@model EditProductDto
@{
    ViewData["Title"] = "Ürün Düzenle";
}
<div class="row">
    <div class="col-md-6 mx-auto">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">
                    @ViewData["Title"]
                </h5>
                <hr />
                <form method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input asp-for="Id" type="hidden" />
                    <div class="form-check form-switch mb-3">
                        <label class="form-check-label" asp-for="Active"></label>
                        <input class="form-check-input" role="switch" asp-for="Active">
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="Title" class="form-control" />
                        <label asp-for="Title"></label>
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3">
                        <textarea asp-for="Description" class="form-control"></textarea>
                        <label asp-for="Description"></label>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="Price" class="form-control" />
                        <label asp-for="Price"></label>
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="DiscountRate" class="form-control" />
                        <label asp-for="DiscountRate"></label>
                        <span asp-validation-for="DiscountRate" class="text-danger"></span>
                    </div>
                   <div class="form-floating mb-3">
                        <select asp-for="TaxRate" class="form-select" asp-items="ViewBag.TaxRates">
                            <option value="">Vergi Dilimi Seçiniz</option>
                        </select>
                        <label asp-for="TaxRate"></label>
                        <span asp-validation-for="TaxRate" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3">
                        <select asp-for="SubCategoryId" asp-items="ViewBag.Categories" class="form-select">
                            <option value="">Kategori Seçiniz</option>
                        </select>
                        <label asp-for="SubCategoryId"></label>
                        <span asp-validation-for="SubCategoryId" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3">
                        <select asp-for="ModelId" asp-items="ViewBag.Models" class="form-select">
                            <option value="">Model Seçiniz</option>
                        </select>
                        <label asp-for="ModelId"></label>
                        <span asp-validation-for="ModelId" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3">
                        <select asp-for="BrandId" asp-items="ViewBag.Brands" class="form-select">
                            <option value="">Marka Seçiniz</option>
                        </select>
                        <label asp-for="BrandId"></label>
                        <span asp-validation-for="BrandId" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="Stock" class="form-control" />
                        <label asp-for="Stock"></label>
                        <span asp-validation-for="Stock" class="text-danger"></span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <a asp-action="index" asp-controller="brand" class="btn btn-secondary">Vazgeç</a>
                        <button class="btn btn-primary" type="submit">Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>