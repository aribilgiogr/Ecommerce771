@model IEnumerable<BrandDto>
@{
    ViewData["Title"] = "Kayıtlı Markalar";
}
<h2>@ViewData["Title"]</h2>
<button class="btn btn-primary">Yeni Marka Ekle</button>
<div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 row-cols-xl-6 g-4">
    @foreach (var item in Model)
    {
        <div class="col">
            <div class="card border-1 shadow-sm">
                <img src="@(item.LogoUrl ?? "https://placehold.co/800x450?text=Logo+Yok")" class="card-img-top" alt="@item.Name" />
                <div class="card-body">
                    <h5 class="card-title">@item.Name</h5>
                    <div class="d-flex justify-content-between">
                        <button class="btn btn-sm btn-info">Düzenle</button>
                        <button class="btn btn-sm btn-danger">Sil</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>