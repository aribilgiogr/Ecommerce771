@model BrandDto
@{
    ViewData["Title"] = "Yeni Marka Ekle";
}
<div class="row">
    <div class="col-md-6 mx-auto">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">
                    @ViewData["Title"]
                </h5>
                <hr />
                <form method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-floating mb-3">
                        <input asp-for="Name" class="form-control" placeholder="Örn. Samsung, Sony vb" />
                        <label asp-for="Name">Marka Adı</label>
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="LogoUrl" class="form-control" placeholder="Örn. https://example.com/logo.jpg" />
                        <label asp-for="LogoUrl">Marka Logosu</label>
                    </div>
                    <div class="d-flex justify-content-between">
                        <a asp-action="index" asp-controller="brand" class="btn btn-secondary">Vazgeç</a>
                        <button class="btn btn-primary" type="submit">Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>